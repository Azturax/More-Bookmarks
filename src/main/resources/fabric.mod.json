{
	"schemaVersion": 1,
	"id": "morebookmarks",
	"version": "${version}",
	"name": "More Bookmarks",
	"description": "Save any EMI, JEI, or REI search as a bookmark. Click one to filter the item index instantly.",
	"authors": [
		"More Bookmarks"
	],
	"contact": {
		"sources": "https://github.com/aztur/More-Bookmarks"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.morebookmarks.MoreBookmarksClient"
		],
		"emi": [
			"dev.morebookmarks.emi.MoreBookmarksEmiPlugin"
		],
		"jei_mod_plugin": [
			"dev.morebookmarks.jei.MoreBookmarksJeiPlugin"
		],
		"rei_client": [
			"dev.morebookmarks.rei.MoreBookmarksReiClientPlugin"
		],
		"modmenu": [
			"dev.morebookmarks.config.MoreBookmarksModMenu"
		]
	},
	"mixins": [
		"morebookmarks.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"emi": ">=1.1.18",
		"jei": "*",
		"roughlyenoughitems": "*",
		"modmenu": "*",
		"cloth-config": "*"
	}
}
